{
  "name": "@fig-tail/match",
  "version": "0.1.0",
  "description": "CSS to Tailwind class matching with a confidence ladder",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "css",
    "figma",
    "fig-tail"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kocheck/fig-tail.git",
    "directory": "packages/match"
  },
  "bugs": {
    "url": "https://github.com/kocheck/fig-tail/issues"
  },
  "homepage": "https://github.com/kocheck/fig-tail#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint src",
    "probe:browser": "node scripts/browser-bundle-probe.mjs"
  },
  "dependencies": {
    "@fig-tail/theme": "workspace:*",
    "culori": "4.0.2"
  },
  "devDependencies": {
    "@types/culori": "4.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
