{
  "name": "@fig-tail/plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: real Tailwind classes in Dev Mode (not published to npm)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.sandbox.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "node build.mjs && vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fig-tail/match": "workspace:*",
    "@fig-tail/theme": "workspace:*",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.109.0",
    "esbuild": "0.27.2"
  }
}
